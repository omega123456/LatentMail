{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the main window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-health-check",
    "allow-open-external-url",
    "allow-write-frontend-log",
    "allow-read-settings",
    "allow-write-setting",
    "allow-pause-queue",
    "allow-resume-queue",
    "allow-read-queue-summary",
    "allow-list-accounts",
    "allow-begin-sign-in",
    "allow-begin-reauthentication",
    "allow-list-labels",
    "allow-lookup-contacts",
    "allow-reply-context",
    "allow-stage-attachment-from-path",
    "allow-stage-attachment-from-bytes",
    "allow-release-staged-attachment",
    "allow-save-compose-draft",
    "allow-send-compose-draft",
    "allow-discard-compose-draft",
    "allow-hydrate-compose-draft",
    "allow-list-threads",
    "allow-load-conversation",
    "allow-fetch-message-body",
    "allow-trigger-sync",
    "allow-read-sync-status",
    "allow-star-thread",
    "allow-unstar-thread",
    "allow-mark-thread-read",
    "allow-mark-thread-unread",
    "allow-mutate-threads",
    "allow-mutate-messages",
    "allow-delete-threads",
    "allow-move-threads",
    "allow-delete-messages",
    "allow-move-messages",
    "allow-search-threads",
    "allow-parse-search-query",
    "allow-delete-draft",
    "allow-create-label",
    "allow-rename-label",
    "allow-recolor-label",
    "allow-delete-label",
    "allow-read-traversal-status",
    "allow-read-sender-avatar",
    "allow-read-account-avatar",
    "dialog:allow-open",
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    "notification:allow-notify",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "http://*" }, { "url": "https://*" }]
    }
  ]
}
