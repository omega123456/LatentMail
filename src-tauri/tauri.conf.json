{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LatentMail",
  "version": "2.2.2",
  "identifier": "com.latentmail.desktop",
  "build": {
    "beforeDevCommand": "pnpm vite --host 127.0.0.1",
    "beforeBuildCommand": "pnpm vite build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LatentMail",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: asset: http://asset.localhost inlineimg: http://inlineimg.localhost remoteimg: http://remoteimg.localhost https: http:",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/compose-staging/**",
          "$APPDATA/avatar-cache/**",
          "$APPDATA/attachment-cache/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "15.0"
    },
    "resources": [
      "resources/THIRD-PARTY-LICENSES.md",
      "resources/LGPL-3.0.txt",
      "resources/GPL-3.0.txt"
    ]
  },
  "plugins": {
    "deep-link": {
      "schemes": [
        "mailto"
      ]
    },
    "updater": {
      "endpoints": [
        "https://github.com/omega123456/LatentMail/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUzNUI0MUEyOTk3RkM2MTkKUldRWnhuK1pva0ZiVXlWaGUxUkdLc3B5K05CeTBtMXFIVzBCaWMvdUswUEM2NjZ1M1hqRHRhVWQK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
